# VITE_SUPABASE_URL: URL do projeto Supabase. Ausente ou "placeholder" ativa o Mock Mode.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Chave anonima do Supabase (publica, nao e segredo).
VITE_SUPABASE_ANON_KEY="your-anon-key"

# DISABLE_HMR: "true" para desativar Hot Module Replacement (util em alguns ambientes de IA).
# DISABLE_HMR="true"
