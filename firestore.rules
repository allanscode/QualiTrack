rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 0.1 Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'marcospaulo@webposto.com.br' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin')
      );
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'email', 'role']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['admin', 'gestor', 'analista', 'tecnico', 'assistente'];
    }

    function isValidTicket(data) {
      return data.keys().hasAll(['externalId', 'agentId']) &&
             data.externalId is string && data.externalId.size() <= 50 &&
             data.agentId is string && data.agentId.size() <= 128;
    }

    function isValidForm(data) {
      return data.keys().hasAll(['title', 'sections']) &&
             data.title is string && data.title.size() <= 200 &&
             data.sections is list && data.sections.size() <= 50;
    }

    function isValidMonitoria(data) {
      return data.keys().hasAll(['ticketId', 'auditorId', 'agentId', 'formId', 'status']) &&
             data.ticketId is string && data.ticketId.size() <= 128 &&
             data.auditorId is string && data.auditorId.size() <= 128 &&
             data.agentId is string && data.agentId.size() <= 128 &&
             data.formId is string && data.formId.size() <= 128 &&
             data.status in ['draft', 'completed'];
    }

    function isValidAccessRequest(data) {
      return data.keys().hasAll(['name', 'email', 'status', 'createdAt']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is string;
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidUser(incoming());
      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidTicket(incoming());
      allow delete: if isAdmin();
    }

    match /forms/{formId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidForm(incoming());
      allow delete: if isAdmin();
    }

    match /monitorias/{monitoriaId} {
      allow read: if isSignedIn() && (
        isAdmin() || 
        resource.data.auditorId == request.auth.token.email || 
        resource.data.agentId == request.auth.token.email ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
         get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'gestor')
      );
      allow create: if isSignedIn() && isValidMonitoria(incoming()) && incoming().auditorId == request.auth.token.email;
      allow update: if isSignedIn() && isValidMonitoria(incoming()) && 
                    existing().status == 'draft' && 
                    existing().auditorId == request.auth.token.email &&
                    incoming().auditorId == existing().auditorId;
      allow delete: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manual or cloud function manages this
    }

    match /accessRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isSignedIn() && isValidAccessRequest(incoming()) && incoming().email == request.auth.token.email;
      allow update, delete: if isAdmin();
    }
  }
}
